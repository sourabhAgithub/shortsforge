# Copy this file to ".env" (same folder) and fill in what you have. All of these are optional.
# Restart ShortsForge after changing it.

# AI Video Generator: AI images come from pollinations.ai.
# Without a key it works for free but only allows about 1 image every 45 seconds.
# A key from https://enter.pollinations.ai removes that wait and the small corner logo.
POLLINATIONS_TOKEN=

# AI Video Generator: stock footage (the "Stock footage" source, and the fallback when AI fails).
# Either key works; if both are set, Pexels is tried first.
# Pixabay (free): sign up at https://pixabay.com, then your key is shown at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Pexels (free, but new keys were paused in Oct 2026): https://www.pexels.com/api/
PEXELS_API_KEY=

# Which AI image provider to use (only "pollinations" is built in for now).
AI_IMAGE_PROVIDER=pollinations

# Voice Generator: ElevenLabs voices, which act out tags like [whispers] or [nervous].
# Optional; without it the free voices are used. Get a key at https://elevenlabs.io (Profile -> API keys).
# ElevenLabs bills per character; its free plan has a small monthly allowance.
ELEVENLABS_API_KEY=
# Which ElevenLabs model to use. eleven_v3 understands the tags; leave empty for that.
ELEVENLABS_MODEL=
